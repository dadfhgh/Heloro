# Create your own Supabase project, then copy its Project URL and publishable key here.
# The publishable key is intended for browser use. NEVER put a service_role/secret key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Analytics stays off until privacy notice/consent and both provider regions/billing are verified.
# Provider keys belong in Supabase Edge Function secrets, never VITE_ variables.
VITE_ANALYTICS_ENABLED=false
