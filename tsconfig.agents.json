{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "./agent-dist",
    "rootDir": "./src",
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/agents/**/*.ts"],
  "exclude": ["src/agents/**/*.test.ts"]
}
